# Copy this file to .env for local development. Never commit real credentials.

# Local OpenAI-compatible model endpoint.
OLLAMA_PRIMARY_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
LINK_LOCAL_FAST_MODEL=local-fast
LINK_LOCAL_DEEP_MODEL=local-deep

# Optional, explicit cloud-advisor configuration.
LINK_ALLOW_OPENROUTER_ADVISOR=0
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=replace-with-a-model-id
OPENROUTER_API_KEY=replace-with-a-real-key-in-your-shell-only
# LINK_OPENROUTER_API_KEY=replace-with-a-real-key-in-your-shell-only

# Optional external archive used only by local research experiments.
# LINK_HEADROOM_COMPRESSION_ARCHIVE=/absolute/path/to/archive.zip
