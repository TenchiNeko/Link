# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, type-checking, and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local Link runtime state and generated receipts
.link/
.link_execution_receipts/
.agents/
playbook.json
feature_list.json
link-human-journal.json
research_memory_modules_scan_*.txt
factory/projects/*/state/
factory/projects/*/runs/
factory/work_orders/*
factory/approvals/*
factory/outputs/*
factory/rejected_outputs/*
!factory/projects/.gitkeep
!factory/work_orders/.gitkeep
!factory/approvals/.gitkeep
!factory/outputs/.gitkeep
!factory/rejected_outputs/.gitkeep

# Local research inputs and downloaded archives
research/
research_extracted/
.link_research_intake/
*.zip
*.tar
*.tar.gz
*.tgz
*.gguf

# Databases, logs, traces, media, and generated reports
*.db
*.sqlite
*.sqlite3
*.log
*.jsonl
*.trace
*.dump
*.mp4
*.mov
*.wav
*.mp3
*.pkl
*.png
*.jpg
*.jpeg
*.webp

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Private factory context is supplied per deployment; only shared governance is tracked.
factory/context/*/
!factory/context/_global/
!factory/context/_global/**

# Scratch/backup files
*.bak
*.bak2
*.bakk
*.pre-*
backups/
logs/
