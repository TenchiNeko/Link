# Link runtime source files must remain visible to git.
# A broad ignore rule previously hid required runtime .py files.
# Keep this narrow: docs/dependency files should be explicitly force-added when needed.
!*.py

# Local Link browser console
!link_web.py\n\n# Link Factory generated runtime state
factory/projects/*/state/
factory/work_orders/*
!factory/work_orders/.gitkeep
factory/approvals/*
!factory/approvals/.gitkeep
factory/outputs/*
!factory/outputs/.gitkeep
factory/rejected_outputs/*
!factory/rejected_outputs/.gitkeep
